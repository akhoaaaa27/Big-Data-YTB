YOUTUBE_API_KEY = your_youtube_api_key_here
# --- PostgreSQL ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=airflow

# --- Tài khoản đăng nhập giao diện Airflow (http://localhost:8080) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=doi_mat_khau_nay_nua

# --- Khóa bảo mật của Airflow: mỗi máy tự sinh khóa riêng ---
# Sinh FERNET_KEY:
#   docker run --rm apache/airflow:3.3.2 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Sinh JWT_SECRET:
#   docker run --rm apache/airflow:3.3.2 python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Windows / Mac: giữ nguyên dòng này để tắt cảnh báo ---
AIRFLOW_UID=50000
# --- GSDMM (đường dẫn bên trong container Airflow; cần chia sẻ đúng source/volume) ---
# Chỉ điền sau khi docker-compose.yml mount thư mục GSDMM và Docker CLI/socket đã được cấu hình.
# Đường dẫn phải tồn tại bên trong container Airflow, không phải đường dẫn Windows.
YTB_GSDMM_COMPOSE_DIR=

# --- PostgreSQL Mart: trong Docker Compose dùng hostname service postgres ---
MART_PGHOST=postgres
MART_PGPORT=5432
MART_PGDATABASE=ytb_mart
MART_PGUSER=airflow
MART_PGPASSWORD=doi_mat_khau_nay

# --- BigQuery: chỉ bật publish khi đã cấu hình Google Cloud credentials ---
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=
